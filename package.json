{
  "name": "supakorn-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs && node scripts/report-placeholders.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "capture:fallback": "node scripts/capture.mjs fallback",
    "capture:review": "node scripts/capture.mjs review",
    "capture:sections": "node scripts/capture.mjs sections",
    "capture:meta": "node scripts/capture.mjs meta"
  },
  "dependencies": {
    "@fontsource/inter-tight": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
